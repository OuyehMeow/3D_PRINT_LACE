# Copy this file to .env (never commit .env to Git)

# Port exposed on your local computer or Home NAS
PORT=8000

# External data folder on host/NAS (Method in the Cloud, Data at Local)
# Examples:
#   Mac/Linux: /Users/you/lace_data_root
#   Synology:  /volume1/docker/3d_print_lace/data
#   TrueNAS:   /mnt/tank/apps/3d_print_lace/data
LACE_HOST_DATA_DIR=./lace_data_local

# Gemini API Key for Stage 1 Image-to-Image Minimalist Style Drafts
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Recommended Gemini image generation model:
#   gemini-2.5-flash-image (fast, high fidelity)
#   gemini-3-pro-image-preview (highest artistic fidelity)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
